<Window x:Class="Checkup.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Checkup" Width="1100" Height="720" MinWidth="900" MinHeight="600" Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"><Grid Margin="34,28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><StackPanel><TextBlock Text="CHECKUP" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="Bold"/><TextBlock Text="Understand your PC before changing it." FontSize="29" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="A transparent Windows health check with reversible repairs." Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel><Border HorizontalAlignment="Right" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="14,9"><StackPanel><TextBlock Text="READ-ONLY MODE" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="Bold"/><TextBlock Text="Nothing changes without review" Foreground="{StaticResource Text}" Margin="0,3,0,0"/></StackPanel></Border></Grid><Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="20" Margin="0,26,0,20"><Grid><StackPanel><TextBlock Text="SYSTEM CHECK" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="SummaryText" Text="Ready to inspect this PC" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock x:Name="EvidenceText" Text="Checkup starts with evidence, not guesses." Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="ScanButton" Content="Run system scan" Click="Scan_Click" Background="{StaticResource Accent}" Foreground="#0E201D"/><Button x:Name="ReportButton" Content="Export report" Click="Report_Click" IsEnabled="False"/></StackPanel></Grid></Border><Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><TextBlock Text="FINDINGS" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="CountText" Text="No scan run yet" HorizontalAlignment="Right" Foreground="{StaticResource Muted}"/></Grid><ListBox x:Name="FindingsList" Grid.Row="1" Margin="0,15,0,0" Background="Transparent" BorderThickness="0"/></Grid></Border><TextBlock Grid.Row="3" Text="Checkup 1.1.0 Â· MIT licensed Â· Not affiliated with Microsoft or Windows" Foreground="{StaticResource Muted}" Margin="0,18,0,0"/></Grid></Window>
